{
  "name": "vsnote-editor",
  "displayName": "VS Note",
  "description": "Rich Text & Markdown Editor in VS Code.",
  "publisher": "lanyue",
  "private": true,
  "version": "0.1.0",
  "main": "./dist/extension/main.js",
  "type": "module",
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "notes",
    "markdown",
    "rich text",
    "wysiwyg",
    "editor"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mengdu/vscode-note.git"
  },
  "homepage": "https://github.com/mengdu/vscode-note#readme",
  "bugs": {
    "url": "https://github.com/mengdu/vscode-note/issues"
  },
  "author": "lanyueos@qq.com",
  "license": "MIT",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "note.editor",
        "displayName": "Note Editor",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.note"
          },
          {
            "filenamePattern": "*.md"
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "note",
        "aliases": [
          "Note File"
        ],
        "icon": {
          "dark": "media/icon.svg",
          "light": "media/icon.svg"
        },
        "extensions": [
          ".note"
        ]
      }
    ],
    "configuration": {
      "title": "VS Note",
      "properties": {
        "vsnote.imageUploadFolder": {
          "type": "string",
          "default": "/assets",
          "scope": "resource",
          "description": "Image upload folder; restricted within the working directory; if it starts with '/', it starts from the working directory."
        },
        "vsnote.editorMaxWidth": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "pattern": "^(|fullscreen|[1-9][0-9]*(px)?)$",
          "description": "Editor maximum width: leave empty for the default (896px), enter a positive pixel width (for example, 1200 or 1200px), or use fullscreen to fill the editor area."
        },
        "vsnote.editorAlignment": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "default": "center",
          "scope": "resource",
          "description": "Horizontal placement of the editor."
        }
      }
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "package": "npm run build && vsce package --no-dependencies",
    "lint": "oxlint"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-blockquote": "^3.33.0",
    "@tiptap/extension-bold": "^3.33.0",
    "@tiptap/extension-bullet-list": "^3.33.0",
    "@tiptap/extension-code": "^3.33.0",
    "@tiptap/extension-code-block": "^3.33.0",
    "@tiptap/extension-code-block-lowlight": "^3.33.1",
    "@tiptap/extension-document": "^3.33.0",
    "@tiptap/extension-find-and-replace": "^3.33.1",
    "@tiptap/extension-hard-break": "^3.33.0",
    "@tiptap/extension-heading": "^3.33.0",
    "@tiptap/extension-highlight": "^3.33.0",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-invisible-characters": "^3.33.1",
    "@tiptap/extension-italic": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/extension-ordered-list": "^3.33.0",
    "@tiptap/extension-paragraph": "^3.33.0",
    "@tiptap/extension-strike": "^3.33.0",
    "@tiptap/extension-subscript": "^3.33.0",
    "@tiptap/extension-superscript": "^3.33.0",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-text": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/extension-underline": "^3.33.0",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/markdown": "^3.33.1",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@types/vscode": "^1.145.0",
    "@zumer/snapdom": "^3.7.4",
    "@zumer/snapdom-pdf": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^11.2.9",
    "lodash.debounce": "^4.0.8",
    "lowlight": "^3.3.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-menu": "^1.3.2",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "use-immer": "^0.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode-webview": "^1.57.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/vsce": "^4.1.1",
    "oxlint": "^1.90.0",
    "sass-embedded": "^1.108.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
